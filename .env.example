# Copy this file to .env.local and fill in your values.

# 1) Shared database — FREE Postgres from Neon, no credit card required.
#    Get a connection string at https://console.neon.tech
DATABASE_URL=

# 2) AI analysis — FREE Groq API key, no credit card required.
#    Get one at https://console.groq.com/keys
GROQ_API_KEY=

# 3) Google Sign-In — free OAuth credentials from Google Cloud Console.
#    Get them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4) NextAuth session encryption secret — any long random string.
#    Generate one at https://generate-secret.vercel.app/32 (or run:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET=

# 5) The URL your app runs at. Keep as-is for local development.
NEXTAUTH_URL=http://localhost:3000
